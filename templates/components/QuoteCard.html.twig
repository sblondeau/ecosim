{# Devis de travaux (composant Twig anonyme) : coût, prime, reste à charge,
   effets estimés, et les deux financements en <twig:Button>. `action` =
   l'ActionView. L'icône vient du catalogue (RenovationDefinition::iconAsset(),
   mappée dans ActionView.iconAsset) : le même asset SVG que la scène quand il
   existe (solaire/PAC/chaudière/batterie), sinon un petit swatch dédié
   (isolation…). Ajouter un travail ne touche plus ce template. #}
{% props action %}
<div class="card quote{{ action.inProgress ? ' quote--in-progress' }}{{ action.crewBusy ? ' quote--blocked' }}">
    <p class="quote-eyebrow">{{ action.inProgress ? 'Chantier en cours' : (action.crewBusy ? 'À programmer' : 'Travaux disponibles') }}</p>
    <div class="quote-head">
        <div class="quote-icon">{{ include(action.iconAsset) }}</div>
        <h2>{{ action.title }}</h2>
    </div>
    <div class="row"><span class="key">Coût à avancer</span><span><strong>{{ action.costLabel }}</strong></span></div>
    {% if action.subsidyLabel is not empty %}
        <div class="row"><span class="key">Prime <span class="muted">(remboursée après travaux)</span></span><span class="pos">+{{ action.subsidyLabel }}</span></div>
        <div class="row"><span class="key">Reste à charge final</span><span>{{ action.netCostLabel }}</span></div>
    {% endif %}
    {% if action.effectLabels is not empty %}
        <div class="effects">
            {% for effect in action.effectLabels %}
                <div>{{ effect }}</div>
            {% endfor %}
        </div>
    {% else %}
        <div class="effects effects-none">Aucun effet mesurable sur votre installation actuelle.</div>
    {% endif %}
    {% if action.adviceMessage is not empty %}
        <p class="quote-advice quote-advice--{{ action.adviceLevel }}">
            <span class="quote-advice-icon">{{ action.adviceLevel == 'caution' ? '⚠️' : '💡' }}</span>
            {{ action.adviceMessage }}
        </p>
    {% endif %}
    {% if action.inProgress %}
        <p class="quote-progress">⏳ {{ action.progressLabel }}</p>
    {% elseif action.crewBusy %}
        <p class="quote-blocked">🚧 Un autre chantier d'artisan est déjà en cours — disponible dès sa pose.</p>
    {% else %}
        {% if action.delayLabel is not empty %}
            <p class="quote-delay">🗓️ {{ action.delayLabel }}</p>
        {% endif %}
        <div class="quote-actions">
            <twig:Button label="Payer comptant" action="order" :params="{work: action.work, financing: 'cash'}" class="btn-primary btn-small" :disabled="not action.cashAllowed" />
            {% if action.loanAllowed %}
                <twig:Button label="Éco-PTZ · {{ action.loanMonthlyLabel }}/mois · 20 ans" action="order" :params="{work: action.work, financing: 'loan'}" />
            {% endif %}
        </div>
    {% endif %}
</div>
